
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EnjoyApp.Controls"
             x:Class="EnjoyApp.Controls.EnjoyCheckBox">

    <UserControl.Styles>

        <Style Selector="Border#CheckMarkBox">
            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>

        <Style Selector="Border#CheckMarkBox.checked">
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
        </Style>

    </UserControl.Styles>

    <Button Background="Transparent"
            BorderThickness="0"
            Padding="0"
            HorizontalAlignment="Left"
            Click="CheckBoxButton_Click"
            Tapped="CheckBoxButton_Tapped">

        <Border x:Name="CheckMarkBox"
                Width="24"
                Height="24"
                CornerRadius="7"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1">

            <TextBlock Text="✓"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource OnAccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=controls:EnjoyCheckBox}}"/>

        </Border>
    </Button>
</UserControl>
