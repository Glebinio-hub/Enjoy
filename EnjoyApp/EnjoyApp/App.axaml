<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:EnjoyApp"
             x:Class="EnjoyApp.App"
             RequestedThemeVariant="Light">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://EnjoyApp/Themes/Burgundy.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- Общая типографика. Ресурсы приходят из активной темы. -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        </Style>

        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource PageTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.metric-value">
            <Setter Property="FontFamily" Value="{DynamicResource NumberFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource MetricFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.micro-label">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource MicroLabelFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Application.Styles>
</Application>
