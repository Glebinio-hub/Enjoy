
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EnjoyApp.Views"
             x:Class="EnjoyApp.Views.MainView">

    <Grid x:Name="RootGrid"
          Background="{DynamicResource CreamBrush}">


        <Grid RowDefinitions="*,Auto">
            <Grid x:Name="ContentGrid"
                  Grid.Row="0"/>

            <Border Grid.Row="1"
                    Padding="16,12,16,10"
                    Background="{DynamicResource CreamBrush}">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*,*,*">

                    <Button x:Name="TiredButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Content="I'm tired"
                            Height="42"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10"
                            Background="{DynamicResource BurgundyBrush}"
                            Foreground="{DynamicResource CreamBrush}"
                            FontFamily="{StaticResource BodyFont}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            CornerRadius="14"
                            Padding="12,6"
                            BorderThickness="0"/>

                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Content="Today"
                            Click="TodayNavigationClick"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            FontFamily="{StaticResource BodyFont}"
                            FontSize="12"
                            Padding="4,10"/>

                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="Plan"
                            Click="PlanNavigationClick"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            FontFamily="{StaticResource BodyFont}"
                            FontSize="12"
                            Padding="4,10"/>

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="AI"
                            IsEnabled="True"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            FontFamily="{StaticResource BodyFont}"
                            FontSize="12"
                            Padding="4,10"/>

                    <Button Grid.Row="1"
                            Grid.Column="3"
                            Content="Me"
                            IsEnabled="True"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            FontFamily="{StaticResource BodyFont}"
                            FontSize="12"
                            Padding="4,10"/>
                </Grid>
            </Border>
        </Grid>



        <Border x:Name="TaskDetailsOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:TaskDetailsView x:Name="TaskDetailsView"/>
        </Border>

        <Border x:Name="CreateTaskOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:CreateTaskView
                x:Name="CreateTaskView"
                Width="370"
                Height="600"
                MaxWidth="420"
                MaxHeight="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="EditTaskOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:EditTaskView
                x:Name="EditTaskView"
                Width="370"
                Height="600"
                MaxWidth="420"
                MaxHeight="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="CreateSubTaskOverlay"
                Background="#80000000"
                IsVisible="False">

            <Grid>
                <Border Background="White"
                        CornerRadius="20,20,0,0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        MaxHeight="420">

                    <views:CreateSubTaskView
                        x:Name="CreateSubTaskView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

                </Border>
            </Grid>

        </Border>

    </Grid>
</UserControl>
