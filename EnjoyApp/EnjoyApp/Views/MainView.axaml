
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EnjoyApp.Views"
             x:Class="EnjoyApp.Views.MainView"
             xmlns:controls="using:EnjoyApp.Controls"
             xmlns:vm="using:EnjoyApp.ViewModels">


    <UserControl.Styles>
        <Style Selector="Button.nav-button">

            <Setter Property="Background" Value="{DynamicResource CreamBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property ="Width" Value="45"/>
            <Setter Property ="Height" Value="55"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Button.nav-button.active">
            <Setter Property="Background" Value="{DynamicResource BurgundyBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CreamBrush}"/>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>


    <Grid x:Name="RootGrid"
          Background="{DynamicResource CreamBrush}">


        <Grid RowDefinitions="*,Auto">
            <Grid x:Name="ContentGrid"
                  Grid.Row="0"/>



            <Border Grid.Row="1"
                    Padding="10,8"
                    Margin="16,0,16,12"
                    HorizontalAlignment="Stretch"
                    Background="#DDF7F2E9"
                    BorderBrush="#70B9A99F"
                    BorderThickness="1"
                    CornerRadius="28"
                    BoxShadow="0 5 18 0 #22000000">

                <Grid>

                    <Border VerticalAlignment="Top"
                            Height="1"
                            Margin="18,1,18,0"
                            Background="#80FFFFFF"
                            IsHitTestVisible="False"/>

                    <!-- Bottom navigation -->
                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        HorizontalAlignment="Stretch"
                        x:Name="NavigationGrid"
                        SizeChanged="NavigationGrid_SizeChanged">

                        <!-- Today -->
                        <Button x:Name="TodayTabButton"
                                Classes="nav-button active"
                                Grid.Column="0"
                                Click="TodayNavigationClick"
                                HorizontalAlignment="Center">

                            <StackPanel Spacing="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="⌂"
                                           FontSize="23"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Today"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Plan -->
                        <Button x:Name="PlanTabButton"
                                Classes="nav-button"
                                Grid.Column="1"
                                Click="PlanNavigationClick"
                                HorizontalAlignment="Center">

                            <StackPanel Spacing="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="▦"
                                           FontSize="21"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Plan"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- AI -->
                        <Button x:Name="AiTabButton"
                                Classes="nav-button"
                                Grid.Column="2"
                                HorizontalAlignment="Center">

                            <StackPanel Spacing="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="✳"
                                           FontSize="21"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="AI"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Me -->
                        <Button x:Name="MeTabButton"
                                Classes="nav-button"
                                Grid.Column="3"
                                HorizontalAlignment="Center">

                            <StackPanel Spacing="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="○"
                                           FontSize="23"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Me"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                </Grid>
            </Border>


        </Grid>



        <Border x:Name="TaskDetailsOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:TaskDetailsView x:Name="TaskDetailsView"/>
        </Border>

        <Border x:Name="CreateTaskOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:CreateTaskView
                x:Name="CreateTaskView"
                Width="370"
                Height="600"
                MaxWidth="420"
                MaxHeight="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="EditTaskOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:EditTaskView
                x:Name="EditTaskView"
                Width="370"
                Height="600"
                MaxWidth="420"
                MaxHeight="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="CreateSubTaskOverlay"
                Background="#80000000"
                IsVisible="False">

            <Grid>
                <Border Background="White"
                        CornerRadius="20,20,0,0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        MaxHeight="420">

                    <views:CreateSubTaskView
                        x:Name="CreateSubTaskView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

                </Border>
            </Grid>

        </Border>
        <Grid x:Name="TimePickerOverlay"
              IsVisible="False"
              RowDefinitions="*,Auto">

            <controls:EnjoyTimePicker
                x:Name="TimePicker"
                x:CompileBindings="False"
                Grid.Row="1"
                SelectedTime="{Binding PickerTime, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"/>

        </Grid>
    </Grid>
</UserControl>
