
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EnjoyApp.Views"
             x:Class="EnjoyApp.Views.MainView">

    <Grid x:Name="RootGrid">

        <Grid RowDefinitions="*,Auto">


            <Grid x:Name="ContentGrid"
                  Grid.Row="0"/>

            <Border Grid.Row="1"
                    Padding="12"
                    Background="#F5F5F5">
                <Grid ColumnDefinitions="*,*,*,*">

                    <Button Grid.Column="0"
                            Content="Today"
                            Click="TodayNavigationClick"/>

                    <Button Grid.Column="1"
                            Content="Plan"
                            Click="PlanNavigationClick"/>

                    <Button Grid.Column="2"
                            Content="AI"
                            IsEnabled="False"/>

                    <Button Grid.Column="3"
                            Content="Me"
                            IsEnabled="False"/>

                </Grid>
            </Border>

        </Grid>


        <Border x:Name="TaskDetailsOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:TaskDetailsView x:Name="TaskDetailsView"/>
        </Border>

        <Border x:Name="CreateTaskOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:CreateTaskView
                x:Name="CreateTaskView"
                Width="370"
                Height="600"
                MaxWidth="420"
                MaxHeight="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="EditTaskOverlay"
                Background="#80000000"
                IsVisible="False">
            <views:EditTaskView
                x:Name="EditTaskView"
                Width="370"
                Height="600"
                MaxWidth="420"
                MaxHeight="650"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="CreateSubTaskOverlay"
                Background="#80000000"
                IsVisible="False">

            <Grid>
                <Border Background="White"
                        CornerRadius="20,20,0,0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        MaxHeight="420">

                    <views:CreateSubTaskView
                        x:Name="CreateSubTaskView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

                </Border>
            </Grid>

        </Border>

    </Grid>
</UserControl>
