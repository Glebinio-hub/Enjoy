<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnjoyApp.ViewModels"
             xmlns:views="using:EnjoyApp.Views"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="EnjoyApp.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid x:Name="RootGrid">
        <Border
            x:Name="TaskDetailsOverlay"
            Background="#80000000"
            IsVisible="False">

            <views:TaskDetailsView
                x:Name="TaskDetailsView"
                Width="370"
                Height="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        </Border>

        <Border
            x:Name="CreateTaskOverlay"
            Background="#80000000"
            IsVisible="False">



            <views:CreateTaskView
                x:Name="CreateTaskView"
                Width="370"
                Height="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <Border
            x:Name="CreateSubTaskOverlay"
            Background="Transparent"
            IsVisible="False"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">

            <views:CreateSubTaskView
                x:Name="CreateSubTaskView"
                Height="300"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"/>

        </Border>



    </Grid>

</UserControl>