
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:EnjoyApp.Views"
             xmlns:vm="using:EnjoyApp.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="800"
             x:Class="EnjoyApp.Views.MeView"
             x:DataType="vm:MeViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground"
                    Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>

        <Style Selector="TextBox.habit-name.invalid">
            <Setter Property="BorderBrush" Value="#D65B62"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="TextBox.habit-name.invalid:focus">
            <Setter Property="BorderBrush" Value="#D65B62"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <!-- ОСНОВНОЙ ЭКРАН -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding !IsHabitDetailsOpen}">

            <StackPanel Margin="20,28,20,36"
                        Spacing="26"
                        HorizontalAlignment="Stretch"
                        MaxWidth="560">

                <!-- HEADER -->

                <StackPanel Spacing="6">

                    <TextBlock Text="YOUR PERSONAL SPACE"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock Text="Your space"
                               Classes="page-title"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Every little step matters."
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                </StackPanel>

                <!-- HABITS -->

                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <TextBlock Grid.Column="0"
                                   Text="My habits"
                                   Classes="section-title"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="+ Add habit"
                                Click="AddHabit_Click"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="14"
                                Padding="14,8"
                                FontFamily="{DynamicResource BodyFont}"
                                FontSize="12"/>

                    </Grid>

                    <ItemsControl ItemsSource="{Binding HabitCards}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HabitCardViewModel">
                                <views:HabitCard
                                    OpenRequested="HabitCard_OpenRequested"
                                    HorizontalAlignment="Stretch"
                                    DeleteRequested="HabitCard_DeleteRequested"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

                <!-- PROGRESS -->

                <StackPanel Spacing="12">

                    <TextBlock Text="Your progress"
                               Classes="section-title"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource DustyRoseBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18">

                        <StackPanel Spacing="10">

                            <TextBlock Text="Your story, over time"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="Your activity charts will appear here."
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- PLAN & REALITY -->

                <StackPanel Spacing="12">

                    <TextBlock Text="Plan &amp; reality"
                               Classes="section-title"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource DustyRoseBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18">

                        <StackPanel Spacing="10">

                            <TextBlock Text="Planned vs completed"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="Your daily task statistics will appear here."
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- MY RHYTHM -->

                <StackPanel Spacing="12">

                    <TextBlock Text="My rhythm"
                               Classes="section-title"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource DustyRoseBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18">

                        <StackPanel Spacing="10">

                            <TextBlock Text="Your planned day"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Text="See when your planned day begins and ends."
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <!-- HABIT DETAILS -->

        <Grid IsVisible="{Binding IsHabitDetailsOpen}"
              RowDefinitions="Auto,*">

            <Border Grid.Row="0"
                    Background="{DynamicResource PageBackgroundBrush}"
                    Padding="20,16">

                <Button Content="← Back"
                        Click="CloseHabitDetails_Click"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="0"
                        FontFamily="{DynamicResource BodyFont}"
                        FontSize="15"
                        Padding="8"/>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding SelectedHabitDetails}">

                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:HabitDetailsViewModel">
                        <views:HabitDetailsView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>

            </ContentControl>
        </Grid>

        <!-- CREATE HABIT OVERLAY -->

        <Border Background="#99000000"
                IsVisible="{Binding IsCreateHabitOpen}">

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DustyRoseBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="24"
                    Margin="20"
                    MaxWidth="420"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">

                <StackPanel Spacing="18">

                    <StackPanel Spacing="6">

                        <TextBlock Text="A LITTLE SOMETHING NEW"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <TextBlock Text="Create a habit"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="30"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Text="Make space for something that matters to you."
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    </StackPanel>

                    <!-- NAME -->

                    <StackPanel Spacing="8">

                        <TextBlock Text="Habit name"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBox Classes.habit-name="True"
                                 Classes.invalid="{Binding HasHabitValidationError}"
                                 Text="{Binding NewHabitName, Mode=TwoWay}"
                                 Watermark="Reading, gym, learning..."
                                 CornerRadius="12"
                                 Padding="12,10"
                                 MaxLength="80"/>

                        <TextBlock Text="{Binding HabitValidationMessage}"
                                   IsVisible="{Binding HasHabitValidationError}"
                                   Foreground="#C45252"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- DESCRIPTION -->

                    <StackPanel Spacing="8">

                        <TextBlock Text="Description (optional)"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBox Text="{Binding NewHabitDescription, Mode=TwoWay}"
                                 Watermark="A little every day..."
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 MaxHeight="140"
                                 MaxLength="300"
                                 CornerRadius="12"
                                 Padding="12,10"/>

                    </StackPanel>

                    <!-- ACTIONS -->

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Click="CancelHabit_Click"
                                Background="{DynamicResource PageBackgroundBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                CornerRadius="12"
                                Padding="12"
                                HorizontalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Create habit"
                                Click="CreateHabit_Click"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="12"
                                Padding="12"
                                HorizontalContentAlignment="Center"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Border>

        <!-- DELETE HABIT OVERLAY -->

        <Border Background="#99000000"
                IsVisible="{Binding IsDeleteHabitOpen}">

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="24"
                    Margin="20"
                    MaxWidth="420"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">

                <StackPanel Spacing="18">

                    <StackPanel Spacing="8">

                        <TextBlock Text="REMOVE HABIT"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <TextBlock Text="Remove this habit?"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="28"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Text="This habit and its completion history will be removed. This action cannot be undone."
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Button Grid.Column="0"
                                Content="Keep habit"
                                Click="CancelDeleteHabit_Click"
                                Background="{DynamicResource PageBackgroundBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                CornerRadius="12"
                                Padding="12"
                                HorizontalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Remove"
                                Click="ConfirmDeleteHabit_Click"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="12"
                                Padding="12"
                                HorizontalContentAlignment="Center"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>
