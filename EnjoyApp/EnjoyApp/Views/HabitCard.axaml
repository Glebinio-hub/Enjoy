<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EnjoyApp.Controls"
             xmlns:vm="using:EnjoyApp.ViewModels"
             x:Class="EnjoyApp.Views.HabitCard"
             x:DataType="vm:HabitCardViewModel"
             HorizontalAlignment="Stretch">

    <UserControl.Styles>
        <Style Selector="Button.habit-options">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.habit-options:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.habit-options:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>




    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="16">

        <Grid ColumnDefinitions="44,*,Auto,Auto"
              ColumnSpacing="10">


            <Border Grid.Column="0"
                    Width="44"
                    Height="44"
                    Background="{DynamicResource AccentSubtleBrush}"
                    CornerRadius="13"
                    VerticalAlignment="Center">

                <TextBlock Text="✦"
                           FontSize="22"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>


            <StackPanel Grid.Column="1"
                        Spacing="5"
                        VerticalAlignment="Center">

                <TextBlock Text="{Binding Name}"
                           FontFamily="{DynamicResource BodyFont}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding StatusText}"
                           FontFamily="{DynamicResource BodyFont}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>


            <Border Grid.Column="2"
                    Width="36"
                    Height="36"
                    Background="{DynamicResource PageBackgroundBrush}"
                    CornerRadius="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <controls:EnjoyCheckBox
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsCompletedToday, Mode=OneWay}"
                    IsCheckedChanged="EnjoyCheckBox_CheckedChanged"/>
            </Border>


            <!-- Кнопка управления привычкой -->
            <Button Grid.Column="3"
                    Content="···"
                    Click="DeleteHabit_Click"
                    Width="32"
                    Height="36"
                    Padding="0"
                    FontSize="20"
                    FontFamily="{DynamicResource BodyFont}"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Habit options"
                    Classes="habit-options"/>

        </Grid>
    </Border>
</UserControl>