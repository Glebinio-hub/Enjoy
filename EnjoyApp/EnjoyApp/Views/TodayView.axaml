<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:EnjoyApp.ViewModels"
             xmlns:controls="using:EnjoyApp.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="393"
             d:DesignHeight="852"
             x:DataType="vm:TodayViewModel"
             x:Class="EnjoyApp.Views.TodayView">

    <Grid Background="{DynamicResource CreamBrush}"
          RowDefinitions="Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="20,12,20,0"
                    Spacing="2">

            <TextBlock Text="{Binding Greeting}"
                       FontFamily="{StaticResource BodyFont}"
                       FontSize="15"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <TextBlock Text="{Binding UserName}"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="36"
                       FontWeight="Regular"
                       FontStyle="Italic"
                       Foreground="{DynamicResource BurgundyBrush}"/>

            <TextBlock Text="{Binding Date}"
                       FontFamily="{StaticResource BodyFont}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="1,1,0,0"/>
        </StackPanel>

        <!-- Main content: scales only when the available space is limited -->
        <Viewbox Grid.Row="1"
                 Margin="12,8,12,8"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <StackPanel Width="369"
                        Spacing="12">

                <!-- Day progress -->
                <Grid Width="190"
                      Height="190"
                      HorizontalAlignment="Center">

                    <controls:ProgressRing
                        Width="190"
                        Height="190"
                        Progress="{Binding DayProgress}"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="2">

                        <TextBlock Text="{Binding DayProgress, StringFormat='{}{0}%'}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="38"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BurgundyBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="OF YOUR DAY"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Tasks progress -->
                <StackPanel HorizontalAlignment="Center"
                            Spacing="6">

                    <TextBlock Text="{Binding CompletedTasksText}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <Grid Width="220"
                          Height="7"
                          ClipToBounds="True">

                        <Border Background="{DynamicResource SoftSandBrush}"
                                CornerRadius="4"/>

                        <Border HorizontalAlignment="Left"
                                Width="{Binding TasksProgress}"
                                Background="{DynamicResource BurgundyBrush}"
                                CornerRadius="4">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width"
                                                      Duration="0:0:0.35"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding RemainingTasksText}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="320"/>
                </StackPanel>

                <!-- Current task / rest card -->
                <Grid Width="369"
                      MinHeight="140">

                    <Border x:Name="TaskCard"
                            IsVisible="False"
                            Opacity="1"
                            RenderTransform="translate(0, 0)"
                            Background="#FFFCF7"
                            MinHeight="140"
                            Padding="18"
                            CornerRadius="24"
                            BorderBrush="#E6DED1"
                            BorderThickness="1"
                            Tapped="ShowDetailsView">

                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.28"/>
                                <TransformOperationsTransition
                                    Property="RenderTransform"
                                    Duration="0:0:0.28"/>
                            </Transitions>
                        </Border.Transitions>

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,*,Auto">

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="8">

                                <Border Background="{DynamicResource DustyRoseBrush}"
                                        CornerRadius="8"
                                        Padding="9,4">
                                    <TextBlock Text="NOW"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BurgundyBrush}"/>
                                </Border>

                                <TextBlock Text="{Binding CurrentTask.TimeRange}"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding CurrentTask.Name}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,10,12,10"/>

                            <CheckBox Grid.Row="1"
                                      Grid.Column="1"
                                      IsChecked="{Binding CurrentTask.IsCompleted}"
                                      IsCheckedChanged="IsTaskCompleted"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6">

                                <Border Width="4"
                                        Height="16"
                                        CornerRadius="2"
                                        Background="{DynamicResource BurgundyBrush}"
                                        VerticalAlignment="Center"/>

                                <TextBlock Text="Your current focus"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="RelaxCard"
                            IsVisible="True"
                            Opacity="1"
                            RenderTransform="translate(0, 0)"
                            Background="#FFFCF7"
                            MinHeight="140"
                            Padding="18"
                            CornerRadius="24"
                            BorderBrush="#E6DED1"
                            BorderThickness="1">

                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.28"/>
                                <TransformOperationsTransition
                                    Property="RenderTransform"
                                    Duration="0:0:0.28"/>
                            </Transitions>
                        </Border.Transitions>

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,*,Auto">

                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="{DynamicResource DustyRoseBrush}"
                                    CornerRadius="8"
                                    Padding="9,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="YOUR TIME"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BurgundyBrush}"/>
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        Margin="0,10,8,10">

                                <TextBlock Text="Время выдохнуть"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="26"
                                           Foreground="{DynamicResource BurgundyBrush}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Сейчас можно никуда не спешить."
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    CornerRadius="19"
                                    Background="{DynamicResource DustyRoseBrush}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                                <TextBlock Text="✳"
                                           FontSize="22"
                                           Foreground="{DynamicResource BurgundyBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Row="2"
                                  Grid.Column="0"
                                  ColumnDefinitions="*,Auto">

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                    <Border Width="4"
                                            Height="16"
                                            CornerRadius="2"
                                            Background="{DynamicResource BurgundyBrush}"
                                            VerticalAlignment="Center"/>

                                    <TextBlock Text="Take your time"
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Plan something"
                                        Padding="10,7"
                                        CornerRadius="12"
                                        Background="{DynamicResource BurgundyBrush}"
                                        Foreground="{DynamicResource CreamBrush}"
                                        FontFamily="{StaticResource BodyFont}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Click="AddTaskButtonClick"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Quote -->
                <Border Width="320"
                        HorizontalAlignment="Center"
                        Padding="14,10"
                        CornerRadius="18"
                        Background="#FFFCF7"
                        BorderBrush="{DynamicResource SoftSandBrush}"
                        BorderThickness="1">

                    <StackPanel Spacing="4">

                        <TextBlock Text="A THOUGHT FOR YOU"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BurgundyBrush}"
                                   HorizontalAlignment="Center"/>

                        <Border Width="24"
                                Height="1"
                                Background="{DynamicResource DustyRoseBrush}"
                                HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding Quote}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="18"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Stretch"/>

                        <TextBlock Text="— a moment to pause"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
