<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:EnjoyApp.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:TodayViewModel"
             x:Class="EnjoyApp.Views.TodayView">

    <UserControl.DataContext>
        <vm:TodayViewModel />
    </UserControl.DataContext>

    <StackPanel>
        <TextBlock Text="{Binding Greeting}" />
        <TextBlock Text="{Binding UserName}" />

        <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" Margin="0,13,0,0" />
                        <TextBlock Text="{Binding StartTime, StringFormat='HH:mm'}" />
                        <TextBlock Text="{Binding EndTime, StringFormat='HH:mm'}" />
                        <CheckBox IsChecked="{Binding IsCompleted}"/>
                    </StackPanel>
                
                
                </DataTemplate>

            </ItemsControl.ItemTemplate>
            
        </ItemsControl>
    </StackPanel>

</UserControl>