<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:EnjoyApp.ViewModels"
             xmlns:controls="using:EnjoyApp.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="393"
             d:DesignHeight="852"
             x:DataType="vm:TodayViewModel"
             x:Class="EnjoyApp.Views.TodayView">


    <Grid ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">
            <TextBlock
                Text="{Binding Greeting}"
                FontSize="24"
                FontWeight="Bold"/>
            <TextBlock
                Text="{Binding UserName}"
                FontSize="24"
                FontWeight="Bold"/>
            <TextBlock
                Text="{Binding Date}"
                FontSize="24"
                FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,50,0,0"
                    Spacing="20">

            <Grid HorizontalAlignment="Center">

                <controls:ProgressRing
                    Width="220"
                    Height="220"
                    Progress="{Binding DayProgress}"/>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding DayProgress, StringFormat='{}{0}%'}"
                        FontSize="32"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="Today"
                        FontSize="14"
                        HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                Spacing="8">

                <TextBlock
                    Text="{Binding CompletedTasksText}"
                    HorizontalAlignment="Center"
                    FontSize="15"/>

                <Border
                    Width="180"
                    Height="6"
                    Background="#E5E7EB"
                    CornerRadius="3">

                    <Border
                        HorizontalAlignment="Left"
                        Width="{Binding TasksProgress}"
                        Background="SlateGray"
                        CornerRadius="3"/>

                </Border>

                <TextBlock
                    Text="{Binding RemainingTasksText}"
                    HorizontalAlignment="Center"
                    FontSize="13"/>

            </StackPanel>

            <Border
                x:Name="TaskCard"
                IsVisible="{Binding HasCurrentTask}"
                Background="SlateGray"
                Width="370"
                Height="140"
                Padding="20"
                CornerRadius="24"
                Tapped="ShowDetailsView">
                <Grid ShowGridLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel
                        HorizontalAlignment="Left"
                        Spacing="5"
                        Grid.Column="0">

                        <TextBlock Text="Now" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding CurrentTask.Name}"/>
                        <TextBlock Text="{Binding CurrentTask.TimeRange}"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <CheckBox
                            IsChecked="{Binding CurrentTask.IsCompleted}"
                            IsCheckedChanged="IsTaskCompleted"
                            Content="Done"/>

                    </StackPanel>

                </Grid>
            </Border>

            <Border
                x:Name="RelaxCard"
                IsVisible="{Binding !HasCurrentTask}"
                Background="SlateGray"
                Width="370"
                Height="140"
                Padding="20"
                CornerRadius="24">
                <Grid ShowGridLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        HorizontalAlignment="Left"
                        Spacing="5"
                        Grid.Column="0">
                        <TextBlock Text="Relax Time"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Nothing in scheduled right now."
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Take a break!"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>



                    </StackPanel>

                    <Button Content ="Do Something"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Click="AddTaskButtonClick"/>



                </Grid>
            </Border>
        </StackPanel>


        <StackPanel
            Spacing="30"
            Grid.Row="2"
            Orientation="Vertical"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

            <Button Content="I`m tired"
                    HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>



</UserControl>