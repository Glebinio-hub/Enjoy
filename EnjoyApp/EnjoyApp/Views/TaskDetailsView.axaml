<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnjoyApp.ViewModels"
             xmlns:controls="using:EnjoyApp.Controls"
             x:DataType="vm:TaskDetailsViewModel"
             mc:Ignorable="d" d:DesignWidth="370" d:DesignHeight="700"
             x:Class="EnjoyApp.Views.TaskDetailsView"
             Background="{DynamicResource CreamBrush}">


    <UserControl.DataContext>
        <vm:TaskDetailsViewModel/>
    </UserControl.DataContext>

    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="CheckBox /template/ Border#PART_Border">
            <Setter Property="Background"
                    Value="{DynamicResource BurgundyBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BurgundyBrush}"/>
        </Style>


    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>






        <Border
            Grid.Row="0"
            Background="{DynamicResource SoftSandBrush}"
            CornerRadius="24"
            Padding="24"
            Margin="16,16,16,10">

            <StackPanel Spacing="14">

                <TextBlock
                    Text="TASK DETAILS"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock
                    Text="{Binding Task.Name}"
                    FontSize="28"
                    FontFamily="{DynamicResource DisplayFont}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    TextWrapping="Wrap"/>

                <TextBlock
                    Text="{Binding Task.Description}"
                    FontSize="14"
                    FontFamily="{DynamicResource BodyFont}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    TextWrapping="Wrap"/>

                <Border
                    Background="{DynamicResource CreamBrush}"
                    CornerRadius="14"
                    Padding="14,12">

                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="SCHEDULE"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="{Binding Task.StartTime}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource BurgundyBrush}"/>

                            <TextBlock
                                Text="—"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock
                                Text="{Binding Task.EndTime}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource BurgundyBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:EnjoyCheckBox
                        IsChecked="{Binding Task.IsCompleted, Mode=TwoWay}"/>
                    <TextBlock Text="Done"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </Border>


        <Border
            Grid.Row="1"
            Background="{DynamicResource CreamBrush}"
            CornerRadius="24"
            Padding="16"
            Margin="16,0,16,12">

            <StackPanel Spacing="14">

                <TextBlock Text="Subtasks"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontSize="26"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <ListBox ItemsSource="{Binding Task.SubTasks}"
                         Background="Transparent"
                         BorderThickness="0">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>

                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>

                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>

                        <Style Selector="ListBoxItem">
                            <Setter Property="FocusAdorner" Value="{x:Null}"/>
                        </Style>

                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>

                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>

                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SoftSandBrush}"
                                    CornerRadius="16"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="6">

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="6">

                                        <TextBlock Text="{Binding StartTime}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock Text="—"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock Text="{Binding EndTime}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <controls:EnjoyCheckBox Grid.Row="0"
                                                            Grid.RowSpan="2"
                                                            Grid.Column="1"
                                                            IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            IsCheckedChanged="IsSubTaskCompletedChanged"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Text="No subtasks yet"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Margin="0,12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    IsVisible="{Binding !HasSubTasks}"/>

            </StackPanel>
        </Border>





        <Border Grid.Row="2"
                Background="{DynamicResource CreamBrush}"
                Padding="16,12,16,20">

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="10">


                <Button Grid.Column="0"
                        Click="CancelButtonClicked"
                        Height="48"
                        CornerRadius="14"
                        Background="{DynamicResource BurgundyBrush}"
                        HorizontalAlignment="Center"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <TextBlock Text="✕"
                               FontSize="20"
                               Foreground="{DynamicResource CreamBrush}"/>
                </Button>


                <Button Grid.Column="1"
                        Click="DeleteButtonClicked"
                        Height="48"
                        CornerRadius="14"
                        Background="{DynamicResource BurgundyBrush}"
                        HorizontalAlignment="Center"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <TextBlock Text="🗑"
                               FontSize="20"
                               Foreground="{DynamicResource CreamBrush}"/>
                </Button>


                <Button Grid.Column="2"
                        Click="EditButtonClick"
                        Height="48"
                        CornerRadius="14"
                        Background="{DynamicResource BurgundyBrush}"
                        HorizontalAlignment="Center"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <TextBlock Text="✎"
                               FontSize="22"
                               Foreground="{DynamicResource CreamBrush}"/>
                </Button>

            </Grid>
        </Border>



    </Grid>

</UserControl>
