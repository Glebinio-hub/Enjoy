
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnjoyApp.ViewModels"
             mc:Ignorable="d"
             x:Class="EnjoyApp.Views.CreateTaskView"
             x:DataType="vm:CreateTaskViewModel"
             d:DesignWidth="370"
             d:DesignHeight="600"
             MaxWidth="420"
             MaxHeight="650"
             FontFamily="{DynamicResource BodyFont}">

    <UserControl.DataContext>
        <vm:CreateTaskViewModel/>
    </UserControl.DataContext>

    <UserControl.Styles>


        <Style Selector="TextBox">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#332A2C"/>
            <Setter Property="BorderBrush" Value="#E8DFD9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>


        <Style Selector="Button.time-chip">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#762A44"/>
            <Setter Property="BorderBrush" Value="#E8DFD9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>


        <Style Selector="Button.secondary">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F2E9E5"/>
            <Setter Property="Foreground" Value="#762A44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>


        <Style Selector="Button.primary">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#762A44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>

    <Border Background="#FFF9F4"
            CornerRadius="24"
            ClipToBounds="True">

        <Grid RowDefinitions="Auto,*,Auto">


            <Grid Grid.Row="0"
                  Margin="24,24,24,12"
                  ColumnDefinitions="*,Auto">

                <StackPanel Spacing="5">

                    <TextBlock Text="New task"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#332A2C"/>

                    <TextBlock Text="Make a little room for what matters."
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="12"
                               Foreground="#96898A"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F2E9E5"
                        CornerRadius="12"
                        Padding="10,6"
                        VerticalAlignment="Top">

                    <TextBlock Text="ENJOY"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#762A44"/>
                </Border>
            </Grid>


            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="24,8,24,16"
                            Spacing="18">


                    <StackPanel Spacing="8">

                        <TextBlock Text="TASK NAME"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#85767A"/>

                        <TextBox Watermark="What would you like to do?"
                                 Text="{Binding Name}"/>

                        <TextBlock Text="{Binding ValidationMessage}"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="12"
                                   Foreground="#C34551"
                                   TextWrapping="Wrap"/>
                    </StackPanel>


                    <StackPanel Spacing="9">

                        <TextBlock Text="TIME"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#85767A"/>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">

                            <Button Grid.Column="0"
                                    Classes="time-chip"
                                    Content="{Binding StartTime, StringFormat='Start: {0:HH:mm}'}"
                                    Click="StartTimeButtonClick"/>

                            <Button Grid.Column="1"
                                    Classes="time-chip"
                                    Content="{Binding EndTime, StringFormat='End: {0:HH:mm}'}"
                                    Click="EndTimeButtonClick"/>
                        </Grid>
                    </StackPanel>


                    <StackPanel Spacing="8">

                        <TextBlock Text="DESCRIPTION"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#85767A"/>

                        <TextBox Watermark="Add a little more detail..."
                                 Text="{Binding Description}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"/>
                    </StackPanel>


                    <StackPanel Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="SUBTASKS"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#85767A"
                                       VerticalAlignment="Center"/>


                            <Button Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Background="#762A44"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="AddSubtaskButtonClick">

                                <TextBlock Text="+"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="24"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <ListBox ItemsSource="{Binding SubTasks}"
                                 MaxHeight="180"
                                 Background="Transparent"
                                 BorderThickness="0">

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E8DFD9"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,6"
                                            Margin="0,0,0,6">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontFamily="{DynamicResource BodyFont}"
                                                       FontSize="14"
                                                       Foreground="#332A2C"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>

                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    FontFamily="{DynamicResource BodyFont}"
                                                    FontSize="15"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#C34551"
                                                    Padding="8,4"
                                                    Command="{Binding $parent[ListBox].DataContext.RemoveSubTaskCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FFF9F4"
                    BorderBrush="#E8DFD9"
                    BorderThickness="0,1,0,0"
                    Padding="24,16,24,22">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">

                    <Button Grid.Column="0"
                            Classes="secondary"
                            Content="Cancel"
                            Padding="20,14"
                            Click="CancelButtonClick"/>

                    <Button Grid.Column="1"
                            Classes="primary"
                            Content="Create task"
                            Command="{Binding AddTaskCommand}"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
