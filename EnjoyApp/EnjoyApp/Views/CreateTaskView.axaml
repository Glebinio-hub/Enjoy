<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnjoyApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="370" d:DesignHeight="600"
             x:DataType="vm:CreateTaskViewModel"
             Background="White"
             x:Class="EnjoyApp.Views.CreateTaskView">

    <UserControl.DataContext>
        <vm:CreateTaskViewModel />
    </UserControl.DataContext>


    <Grid Margin="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Create Task"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBox
                Watermark="Task Name"
                Text="{Binding Name}"
                />

            <StackPanel
                Orientation="Horizontal"
                Spacing="8" >
                <ComboBox
                    Width="120"
                    PlaceholderText="StartTime"
                    ItemsSource="{Binding AvailableTimes}"
                    SelectedItem="{Binding StartTime}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0:HH\\:mm}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox
                    Width="120"
                    PlaceholderText="End time"
                    ItemsSource="{Binding AvailableTimes}"
                    SelectedItem="{Binding EndTime}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0:HH\\:mm}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
            </StackPanel>

            <TextBox
                Watermark="Description"
                Text="{Binding Description}"/>
        </StackPanel>
        <Button
                Content="Cancel"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Click="CancelButtonClick"/>
        <Button
            Content="AddTask"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"/>





    </Grid>



</UserControl>
