<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnjoyApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320"
             d:DesignHeight="360"
             x:DataType="vm:CreateSubTaskViewModel"
             x:Class="EnjoyApp.Views.CreateSubTaskView"
             Background="White">

    <UserControl.DataContext>
        <vm:CreateSubTaskViewModel />
    </UserControl.DataContext>
    <Grid
        ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Spacing="15"
            Orientation="Vertical"
            Margin="24">

            <TextBlock
                Text="Add a subtask"
                FontSize="18"
                FontWeight="Bold"/>
            <TextBox
                Watermark="Name"
                Text="{Binding Name}"/>
            <ComboBox
                Width="120"
                PlaceholderText="StartTime"
                ItemsSource="{Binding AvailableTimes}"
                SelectedItem="{Binding StartTime}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0:HH\\:mm}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox
                Width="120"
                PlaceholderText="End time"
                ItemsSource="{Binding AvailableTimes}"
                SelectedItem="{Binding EndTime}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0:HH\\:mm}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>
        </StackPanel>


        <Button
            Grid.Row="1"
            Content="Cancel"
            Margin="5"
            Click="CancelButtonClick"/>
        <Button
            Grid.Row="1"
            Content="Add"
            HorizontalAlignment="Right"
            Margin="5"
            Command="{Binding AddSubTaskCommand}"/>

            </Grid>
</UserControl>
        