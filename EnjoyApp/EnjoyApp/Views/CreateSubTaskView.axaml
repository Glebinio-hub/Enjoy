
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnjoyApp.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="320"
             d:DesignHeight="360"
             x:DataType="vm:CreateSubTaskViewModel"
             x:Class="EnjoyApp.Views.CreateSubTaskView"
             Background="#F7F2E9">

    <UserControl.Styles>

        <!-- Input fields -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFCF8"/>
            <Setter Property="Foreground" Value="#302A2D"/>
            <Setter Property="BorderBrush" Value="#E5D8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FFFCF8"/>
            <Setter Property="Foreground" Value="#302A2D"/>
            <Setter Property="BorderBrush" Value="#E5D8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Base button style -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Secondary button -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E8D8D6"/>
            <Setter Property="Foreground" Value="#702F40"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Primary button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#702F40"/>
            <Setter Property="Foreground" Value="#F7F2E9"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </UserControl.Styles>

    <UserControl.DataContext>
        <vm:CreateSubTaskViewModel />
    </UserControl.DataContext>

    <Grid RowDefinitions="*,Auto"
          Margin="24,22,24,18">

        <!-- Content -->
        <StackPanel Grid.Row="0"
                    Spacing="14">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Add a subtask"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#702F40"/>

                <TextBlock Text="Small steps make the day easier."
                           FontSize="12"
                           Foreground="#7B6D70"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Name -->
            <StackPanel Spacing="6">
                <TextBox Watermark="What needs to be done?"
                         Text="{Binding Name, Mode=TwoWay}"/>

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#A43D50"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Time selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="TIME"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#7B6D70"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <StackPanel Grid.Column="0"
                                Spacing="6">
                        <TextBlock Text="Start time"
                                   FontSize="12"
                                   Foreground="#66595C"/>

                        <ComboBox HorizontalAlignment="Stretch"
                                  PlaceholderText="Start"
                                  ItemsSource="{Binding AvailableTimes}"
                                  SelectedItem="{Binding StartTime, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0:HH\\:mm}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="6">
                        <TextBlock Text="End time"
                                   FontSize="12"
                                   Foreground="#66595C"/>

                        <ComboBox HorizontalAlignment="Stretch"
                                  PlaceholderText="End"
                                  ItemsSource="{Binding AvailableTimes}"
                                  SelectedItem="{Binding EndTime, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0:HH\\:mm}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                </Grid>
            </StackPanel>

        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Margin="0,18,0,0">

            <Button Grid.Column="0"
                    Classes="secondary"
                    Content="Cancel"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="CancelButtonClick"/>

            <Button Grid.Column="1"
                    Classes="primary"
                    Content="Add subtask"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding AddSubTaskCommand}"/>

        </Grid>

    </Grid>

</UserControl>
