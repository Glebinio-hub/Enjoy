
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnjoyApp.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="320"
             d:DesignHeight="360"
             x:DataType="vm:CreateSubTaskViewModel"
             x:Class="EnjoyApp.Views.CreateSubTaskView"
             Background="#F7F2E9">

    <UserControl.Styles>

        <Style Selector="TextBox">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#332A2C"/>
            <Setter Property="BorderBrush" Value="#E8DFD9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>


        <Style Selector="Button.time-chip">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#762A44"/>
            <Setter Property="BorderBrush" Value="#E8DFD9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>


        <Style Selector="Button.secondary">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F2E9E5"/>
            <Setter Property="Foreground" Value="#762A44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>


        <Style Selector="Button.primary">
            <Setter Property="FontFamily"
                    Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#762A44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>

    <UserControl.DataContext>
        <vm:CreateSubTaskViewModel />
    </UserControl.DataContext>

    <Grid RowDefinitions="*,Auto"
          Margin="24,22,24,18">

        <!-- Content -->
        <StackPanel Grid.Row="0"
                    Spacing="14">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Add a subtask"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#702F40"/>

                <TextBlock Text="Small steps make the day easier."
                           FontSize="12"
                           Foreground="#7B6D70"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Name -->
            <StackPanel Spacing="6">
                <TextBox Watermark="What needs to be done?"
                         Text="{Binding Name, Mode=TwoWay}"/>

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#A43D50"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Time selection -->
              <StackPanel Spacing="9">

                        <TextBlock Text="TIME"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#85767A"/>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">

                            <Button Grid.Column="0"
                                    Classes="time-chip"
                                    Content="{Binding StartTime, StringFormat='Start: {0:HH:mm}'}"
                                    Click="StartTimeButtonClick"/>

                            <Button Grid.Column="1"
                                    Classes="time-chip"
                                    Content="{Binding EndTime, StringFormat='End: {0:HH:mm}'}"
                                    Click="EndTimeButtonClick"/>
                        </Grid>
                    </StackPanel>

        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Margin="0,18,0,0">

            <Button Grid.Column="0"
                    Classes="secondary"
                    Content="Cancel"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="CancelButtonClick"/>

            <Button Grid.Column="1"
                    Classes="primary"
                    Content="Add subtask"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding AddSubTaskCommand}"/>

        </Grid>

    </Grid>

</UserControl>
